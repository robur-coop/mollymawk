opam-version: "2.0"
synopsis:     "Library implementing functionality used by Mollymawk"
name:         "mollymawk_libraries"
homepage:     "https://github.com/robur-coop/mollymawk"
dev-repo:     "git+https://github.com/robur-coop/mollymawk.git"
bug-reports:  "https://github.com/robur-coop/mollymawk/issues"
author:       ["robur"]
maintainer:   ["robur"]
license:      "BSD-2-Clause"

build: [
  ["dune" "subst" ] {dev}
  ["dune" "build"   "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]

depends: [
  "dune"
  "ocaml" {with-test & >= "5.5.0"}
  "ocaml"
  "logs"
  "uuidm" {>= "0.9.10"}
  "ptime" {>= "1.2.0"}
  "albatross" {>= "2.8.2"}
  "mirage-crypto-rng" {>= "2.1.0"}
  "mirage-crypto-rng-mkernel" {>= "2.1.0"}
  "mirage-crypto-rng-miou-unix" {>= "2.1.0"}
  "mirage-ptime" {>= "5.2.0"}
  "mrmime" {>= "0.8.0"}
  "tyxml" {>= "5.0.0"}
  "alcotest" {>= "1.9.1"}
  "multipart_form" {>= "0.8.0"}
  "multipart_form-miou" {>= "0.8.0"}
  "colombe" {>= "0.13.1"}
  "msendmail" {>= "0.13.1"}
  "fmt" {>= "0.11.0"}
  "x509" {>= "1.2.0"}
  "ipaddr" {>= "5.6.2"}
  "ohex" {>= "0.2.0"}
  "emile" {>= "1.1"}
  "uri" {>= "4.4.0"}
  "duration" {>= "0.3.1"}
  "bisect_ppx_ng"
  "ocamlformat" {= "0.29.0"}
  "cmdliner"
  "mcrunch" {>= "0.0.5"}
  "ocaml-solo5" {>= "1.3.4"}
  "solo5-elftool" {>= "0.4.0"}
  "mkernel" {>= "0.0.5"}
  "mnet" {>= "0.0.9"}
  "mnet-dhcp"
  "mnet-cli" {>= "0.0.9"}
  "mnet-dns" {>= "0.0.9"}
  "mnet-happy-eyeballs" {>= "0.0.9"}
  "mnet-tls" {>= "0.0.9"}
  "mhttp" {>= "0.0.5"}
  "mhttp-client" {>= "0.0.5"}
  "mhttp-server" {>= "0.0.5"}
  "vif" {>= "0.0.1~beta6"}
  "vifu" {>= "0.0.1~beta6"}
  "utcp" {>= "0.0.9"}
  "ca-certs-nss" {>= "3.129-1"}
  "digestif" {>= "1.4.1"}
  "jsont" {>= "0.4.0"}
  "bytesrw" {>= "0.3.0"}
  "miou" {>= "0.10.2"}
  "h1" {>= "1.1.1"}
]
